# PostgreSQL / Prisma
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/allino?schema=public"

# Frontend origins allowed to call this API, comma-separated
ALLOWED_ORIGINS="http://localhost:3000,https://savrdhcapital-debug.github.io"

# Set true when the API is served over HTTPS
COOKIE_SECURE="true"
PORT="4000"

# Used only by `npm run seed`; never commit the real value
DEMO_ADMIN_EMAIL="admin@allino.in"
DEMO_ADMIN_PASSWORD="change-this-before-deploying"
DEMO_ADMIN_NAME="Allino Admin"
